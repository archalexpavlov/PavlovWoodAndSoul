# ============================================================
#  PAVLOV — правила хранения файлов в git
#  Настраивается один раз. Батник для LFS больше не нужен.
# ============================================================

# ---------- Текст: обычные диффы, LF везде ----------
*.md            text eol=lf
*.html          text eol=lf
*.htm           text eol=lf
*.txt           text eol=lf
*.csv           text eol=lf
*.json          text eol=lf
*.svg           text eol=lf
*.py            text eol=lf
.gitattributes  text eol=lf

# ---------- Excel: НЕ в LFS ----------
# Файл маленький и меняется часто. В обычном git к нему
# подключён textconv — git diff показывает изменения по ячейкам.
*.xlsx          -text diff=xlsx
*.xlsm          -text diff=xlsx

# ---------- Растровые картинки → LFS ----------
*.png           filter=lfs diff=lfs merge=lfs -text
*.jpg           filter=lfs diff=lfs merge=lfs -text
